enable
configure terminal

! ============================================================
! IMPORTANT - REPLACE BEFORE EXECUTION
! ============================================================
! Replace placeholders with real values before pasting.
! Do NOT paste <ENABLE_SECRET> or <LABADMIN_PASSWORD> literally.
! <ENABLE_SECRET>     : local enable secret
! <LABADMIN_PASSWORD> : local labadmin password
!
! Managed scope: Gi1/0/10-18 and Port-channel1-3.
! Do not reset/shutdown unrelated switch ports.

! ============================================================
! COMMON BASE / MANAGEMENT
! ============================================================
hostname LAB-FCC-BLU-SA01
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
no service password-encryption
logging buffered 16384 informational
clock timezone JST 9 0

no ip domain-lookup
ip domain-name lab.lan
vtp mode transparent
lldp run

enable secret <ENABLE_SECRET>
no enable password
username labadmin privilege 15 secret <LABADMIN_PASSWORD>

aaa new-model
aaa authentication login default local
aaa authorization exec default local

interface FastEthernet0
 description OOB Management SSH
 ip address 172.24.250.133 255.255.255.0
 no shutdown
 exit

interface Vlan1
 no ip address
 shutdown
 exit

no ip http server
ip http authentication local
ip http secure-server
ip ssh version 2
ip scp server enable

line con 0
 exec-timeout 30 0
 logging synchronous
 exit

line vty 0 15
 exec-timeout 30 0
 transport input ssh
 exit

ntp server 10.128.0.1 prefer
ntp server 10.128.0.2

! ============================================================
! RESET OWNED INTERFACES
! ============================================================
default interface GigabitEthernet1/0/10
default interface GigabitEthernet1/0/11
default interface GigabitEthernet1/0/12
default interface GigabitEthernet1/0/13
default interface GigabitEthernet1/0/14
default interface GigabitEthernet1/0/15
default interface GigabitEthernet1/0/16
default interface GigabitEthernet1/0/17
default interface GigabitEthernet1/0/18
default interface Port-channel1
default interface Port-channel2
default interface Port-channel3

! ============================================================
! REQUIRED VLAN
! ============================================================
vlan 1100
 exit
vlan 1101
 exit
vlan 1102
 exit
vlan 1103
 exit
vlan 1132
 exit
vlan 1133
 exit
vlan 1134
 exit
vlan 1135
 exit
vlan 1164
 exit
vlan 1165
 exit
vlan 1166
 exit
vlan 1167
 exit
vlan 2200
 exit
vlan 2201
 exit
vlan 3300
 exit
vlan 3332
 exit
vlan 3364
 exit

! ============================================================
! pve01 / bond0 / Gi10-12 / Port-channel1
! ============================================================
interface range GigabitEthernet1/0/10 - 12
 description pve01 bond0 LACP member
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 switchport nonegotiate
 speed auto
 duplex auto
 channel-group 1 mode active
 no shutdown
 exit

interface Port-channel1
 description pve01 bond0 LACP
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 spanning-tree portfast trunk
 spanning-tree bpduguard enable
 no shutdown
 exit

! ============================================================
! pve02 / bond0 / Gi13-15 / Port-channel2
! ============================================================
interface range GigabitEthernet1/0/13 - 15
 description pve02 bond0 LACP member
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 switchport nonegotiate
 speed auto
 duplex auto
 channel-group 2 mode active
 no shutdown
 exit

interface Port-channel2
 description pve02 bond0 LACP
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 spanning-tree portfast trunk
 spanning-tree bpduguard enable
 no shutdown
 exit

! ============================================================
! pve03 / bond0 / Gi16-18 / Port-channel3
! ============================================================
interface range GigabitEthernet1/0/16 - 18
 description pve03 bond0 LACP member
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 switchport nonegotiate
 speed auto
 duplex auto
 channel-group 3 mode active
 no shutdown
 exit

interface Port-channel3
 description pve03 bond0 LACP
 switchport mode trunk
 switchport trunk allowed vlan 1100-1103,1132-1135,1164-1167,2200-2201,3300,3332,3364
 spanning-tree portfast trunk
 spanning-tree bpduguard enable
 no shutdown
 exit

end

