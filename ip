@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title Windows IPv4 Settings Tool

:: 管理者権限チェック
net session >nul 2>&1
if not "%errorlevel%"=="0" (
    echo.
    echo [ERROR] このバッチは管理者権限で実行してください。
    echo         右クリック ^> 「管理者として実行」
    echo.
    pause
    exit /b 1
)

:START
cls
echo ============================================================
echo   Windows IPv4 Settings Tool
echo ============================================================
echo.
echo [現在のIPv4インターフェース]
echo.
netsh interface ipv4 show interfaces
echo.
echo ------------------------------------------------------------
echo NIC名の例: Ethernet
echo ------------------------------------------------------------
echo.

set "NIC="
set /p "NIC=変更するNIC名を入力してください: "

if not defined NIC (
    echo.
    echo [ERROR] NIC名が入力されていません。
    pause
    goto START
)

:: NIC存在確認
netsh interface ipv4 show config name="%NIC%" >nul 2>&1
if not "%errorlevel%"=="0" (
    echo.
    echo [ERROR] NIC "%NIC%" が見つかりません。
    pause
    goto START
)

echo.
echo [現在の設定]
netsh interface ipv4 show config name="%NIC%"
echo.
echo ------------------------------------------------------------

set "IP="
set "MASK="
set "GW="

set /p "IP=IPアドレスを入力してください          : "
set /p "MASK=サブネットマスクを入力してください  : "
set /p "GW=デフォルトゲートウェイを入力してください: "

if not defined IP (
    echo.
    echo [ERROR] IPアドレスが入力されていません。
    pause
    goto START
)

if not defined MASK (
    echo.
    echo [ERROR] サブネットマスクが入力されていません。
    pause
    goto START
)

if not defined GW (
    echo.
    echo [ERROR] デフォルトゲートウェイが入力されていません。
    pause
    goto START
)

echo.
echo ============================================================
echo [設定内容]
echo NIC               : %NIC%
echo IPアドレス        : %IP%
echo サブネットマスク  : %MASK%
echo デフォルトGW      : %GW%
echo ============================================================
echo.

set "ANS="
set /p "ANS=この内容で変更しますか？ [Y/N]: "

if /I not "%ANS%"=="Y" (
    echo.
    echo 変更をキャンセルしました。
    pause
    goto START
)

echo.
echo IPv4設定を変更しています...

netsh interface ipv4 set address name="%NIC%" source=static address=%IP% mask=%MASK% gateway=%GW% gwmetric=1

if not "%errorlevel%"=="0" (
    echo.
    echo [ERROR] IPv4設定の変更に失敗しました。
    echo         入力値、NIC名、管理者権限を確認してください。
    echo.
    pause
    goto START
)

echo.
echo [SUCCESS] IPv4設定を変更しました。
echo.
echo [変更後の設定]
netsh interface ipv4 show config name="%NIC%"
echo.
echo ※ DNS設定は変更していません。
echo.

set "AGAIN="
set /p "AGAIN=別の設定を行いますか？ [Y/N]: "

if /I "%AGAIN%"=="Y" goto START

endlocal
exit /b 0