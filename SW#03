! ============================================================
! IMPORTANT - REPLACE BEFORE EXECUTION
! ============================================================
! Replace placeholders with real values before pasting.
! Do NOT paste <ENABLE_SECRET> or <LABADMIN_PASSWORD> literally.
! <ENABLE_SECRET>     : local enable secret
! <LABADMIN_PASSWORD> : local labadmin password
!
! Managed scope: Gi1/0/10-27 and Port-channel1-3.
! Do not reset/shutdown unrelated switch ports or unrelated VLANs.

! ============================================================
! COMMON BASE / MANAGEMENT
! ============================================================
hostname LAB-FCC-RED-SA01
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
no service password-encryption
logging buffered 16384 informational
clock timezone JST 9 0

no ip domain-lookup
ip domain-name lab.lan
vtp mode transparent
lldp run

enable secret <ENABLE_SECRET>
no enable password
username labadmin privilege 15 secret <LABADMIN_PASSWORD>

aaa new-model
aaa authentication login default local
aaa authorization exec default local

interface FastEthernet0
 description OOB Management SSH
 ip address 172.24.250.147 255.255.255.0
 no shutdown
 exit

interface Vlan1
 no ip address
 shutdown
 exit

no ip http server
ip http authentication local
ip http secure-server
ip ssh version 2
ip scp server enable

line con 0
 exec-timeout 30 0
 logging synchronous
 exit

line vty 0 15
 exec-timeout 30 0
 transport input ssh
 exit

ntp server 10.128.0.1 prefer
ntp server 10.128.0.2

