[[inputs.syslog]]
  server = "tcp4://:5514"
  framing = "non-transparent"
  trailer = "LF"
  syslog_standard = "RFC5424"

  [inputs.syslog.tags]
    service_namespace = "storage"
    service_name = "netapp-ontap"


[[processors.rename]]
  order = 1
  namepass = ["syslog"]

  [[processors.rename.replace]]
    tag = "hostname"
    dest = "host_name"


[[processors.converter]]
  order = 2
  namepass = ["syslog"]

  [processors.converter.tags]
    string = ["severity", "facility", "appname", "source"]


[[outputs.loki]]
  domain = "http://<LOKI_ADDRESS>:3100"
  endpoint = "/loki/api/v1/push"
  timeout = "5s"

  metric_name_label = ""

  taginclude = [
    "service_namespace",
    "service_name",
    "host_name"
  ]