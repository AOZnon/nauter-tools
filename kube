          name: 'Kubernetes: Events: Critical warning count'
          type: DEPENDENT
          key: kube.events.critical.count
          delay: '0'
          history: 7d
          description: '直近 {$KUBE.EVENT.LOOKBACK.SEC} 秒に発生した Warning Event のうち、重大理由（{$KUBE.EVENT.CRITICAL.REASONS}）に一致するイベント数を取得します。'
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var data = JSON.parse(value);
                  var items = data.items || [];
                  var criticalRe = new RegExp('{$KUBE.EVENT.CRITICAL.REASONS}');
                  var lookbackMs = Number('{$KUBE.EVENT.LOOKBACK.SEC}') * 1000;
                  var cutoff = Date.now() - lookbackMs;
                  var count = 0;
                  
                  for (var i = 0; i < items.length; i++) {
                      var e = items[i];
                      if (e.type !== 'Warning') continue;
                      var reason = e.reason || '';
                      if (!(criticalRe.test(reason))) continue;
                  
                      var ts = (e.series && e.series.lastObservedTime) ||
                               e.lastTimestamp ||
                               e.eventTime ||
                               e.firstTimestamp ||
                               (e.metadata && e.metadata.creationTimestamp);
                      if (!ts) continue;
                  
                      var eventTime = Date.parse(ts);
                      if (!isNaN(eventTime) && eventTime >= cutoff) count++;
                  }
                  return count;
