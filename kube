                - |
                  function unescapeLabel(v) {
                      return v.replace(/\\n/g, '\n').replace(/\\"/g, '"').replace(/\\\\/g, '\\');
                  }
                  
                  function parseLabels(s) {
                      var labels = {}, re = /([a-zA-Z_][a-zA-Z0-9_]*)="((?:\\.|[^"\\])*)"/g, m;
                      while ((m = re.exec(s)) !== null) {
                          labels[m[1]] = unescapeLabel(m[2]);
                      }
                      return labels;
                  }
                  
                  function metricRows(text, metricName) {
                      var rows = [], lines = text.split(/\r?\n/), prefix = metricName + '{';
                      for (var i = 0; i < lines.length; i++) {
                          var line = lines[i];
                          if (line.indexOf(prefix) !== 0) continue;
                          var end = line.lastIndexOf('}');
                          if (end < prefix.length) continue;
                          var value = Number(line.substring(end + 1).trim().split(/\s+/)[0]);
                          if (!isNaN(value) && value !== 1) continue;
                          rows.push(parseLabels(line.substring(prefix.length, end)));
                      }
                      return rows;
                  }
                  
                  var clusterId = '{$KUBE.CLUSTER.ID}';
                                    var podInfo = metricRows(value, 'kube_pod_info');
                  var podOwner = metricRows(value, 'kube_pod_owner');
                  var rsOwner = metricRows(value, 'kube_replicaset_owner');
                  var containers = metricRows(value, 'kube_pod_container_info');
                  
                  var podInfoByKey = {}, podOwnerByKey = {}, rsOwnerByKey = {};
                  var i, k;
                  for (i = 0; i < podInfo.length; i++) {
                      k = podInfo[i].namespace + '\u0000' + podInfo[i].pod;
                      podInfoByKey[k] = podInfo[i];
                  }
                  for (i = 0; i < podOwner.length; i++) {
                      if (podOwner[i].owner_is_controller && podOwner[i].owner_is_controller !== 'true') continue;
                      k = podOwner[i].namespace + '\u0000' + podOwner[i].pod;
                      podOwnerByKey[k] = podOwner[i];
                  }
                  for (i = 0; i < rsOwner.length; i++) {
                      if (rsOwner[i].owner_is_controller && rsOwner[i].owner_is_controller !== 'true') continue;
                      k = rsOwner[i].namespace + '\u0000' + rsOwner[i].replicaset;
                      rsOwnerByKey[k] = rsOwner[i];
                  }
                  
                  var out = [];
                  for (i = 0; i < containers.length; i++) {
                      var c = containers[i];
                      if (!c.container || !c.namespace || !c.pod) continue;
                      k = c.namespace + '\u0000' + c.pod;
                      var pinfo = podInfoByKey[k] || {};
                      var owner = podOwnerByKey[k] || {};
                      var workloadType = owner.owner_kind || pinfo.created_by_kind || 'Pod';
                      var workload = owner.owner_name || pinfo.created_by_name || c.pod;
                  
                      if (workloadType === 'ReplicaSet') {
                          var rs = rsOwnerByKey[c.namespace + '\u0000' + workload];
                          if (rs && rs.owner_kind === 'Deployment' && rs.owner_name) {
                              workloadType = 'Deployment';
                              workload = rs.owner_name;
                          }
                      }
                  
                      out.push({
                          namespace: c.namespace,
                          pod: c.pod,
                          uid: c.uid || pinfo.uid || '',
                          node: pinfo.node || '',
                          container: c.container,
                          workload_type: workloadType,
                          workload: workload,
                          cluster_id: clusterId
                      });
                  }
                  return JSON.stringify(out);
